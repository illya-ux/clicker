<ScreenMenu>:
    BoxLayout:
        canvas:
            Rectangle:
                size: self.size
                pos: self.pos
                source: 'assets/menu.jpg'

        orientation: 'vertical'
        spacing: "20dp"
        padding: "50dp"

        Label:
            text: 'Побег\n с Селены-4'
            halign: "center"
            font_size: "48sp"
            color: 1, 1, 0.9

        Button:
            text: "shop"
            font_size: "36sp"
            color: 1, 1, 1
            background_normal: ''
            background_down: ''
            background_color: (0.45, 0.8, 1, 1)
            on_press: root.go_shop()

        Button:
            text: "play"
            font_size: "48sp"
            color: 1, 1, 1
            background_normal: ''
            background_down: ''
            background_color: (0.55, 0.88, 1, 1)
            on_press: root.go_game()


<ScreenGame>:
    BoxLayout:
        canvas:
            Rectangle:
                size: self.size
                pos: self.pos
                source: 'assets/game_menu.jpg'

        orientation: 'vertical'
        spacing: "50dp"
        padding: "30dp"

        # -------------------- ПАНЕЛЬ HUD --------------------
        BoxLayout:
            size_hint: 1, 0.15
            spacing: "10dp"
            padding: "10dp"

            canvas.before:
                Color:
                    rgb: 0.1, 0.14, 0.28
                Rectangle:
                    size: self.size
                    pos: self.pos

            Label:
                text: "clicks: 0"
                font_size: "22sp"
                color: 0.7, 0.9, 1

            Label:
                text: "gelii - 3"
                font_size: "22sp"
                color: 0.5, 1, 0.8

        Widget:
            size_hint_y: 0.1

        # -------------------- КЛИКАБЕЛЬНЫЙ ОБЪЕКТ -------------------
        Button:
            background_down: 'assets/luna.png'
            background_normal: 'assets/luna.png'
            size_hint: 1, 0.5
            pos_hint: {"center_x": 0.5}

        Widget:
            size_hint_y: 0.1

        Button:
            text: "back"
            size_hint: 0.2, 0.1
            pos_hint: {"right": 1}
            color: 1, 1, 1
            background_color: 0.4, 0.6, 0.9
            background_normal: ''
            on_press: root.back()


<ScreenShop>:
    BoxLayout:
        canvas.before:
            Color:
                rgb: 0.08, 0.1, 0.2
            Rectangle:
                size: self.size
                pos: self.pos

        orientation: 'vertical'
        spacing: "20dp"
        padding: "30dp"

        BoxLayout:
            orientation: 'horizontal'
            size_hint: 1, 0.25

            Button:
                background_normal: 'assets/Тепловой щит.jpg'
                background_down: 'assets/Тепловой щит.jpg'

            Button:
                background_normal: 'assets/Усилений бур.jpg'
                background_down: 'assets/Усилений бур.jpg'

        Label:
            text: "Shop"
            font_size: "40sp"
            color: 1, 1, 1

        Button:
            text: "back"
            size_hint: 0.2, 0.1
            pos_hint: {"right": 1}
            color: 1, 1, 1
            background_color: 0.4, 0.6, 0.9
            background_normal: ''
            on_press: root.back()